      ],
      "id": "d1a1b111-0000-4000-8000-000000000002",
      "name": "Get digest_mails rows",
      "credentials": {
        "httpHeaderAuth": {
          "id": "Lfuh7XFXewkeDjJe",
          "name": "n8n API Key (interne)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.data || [];\n\nconst LIMIT = 3800; // limite Telegram : 4096 caractères par message\nconst LABELS = { 'v.caufriez': 'v.caufriez@ebanista.fr', 'contact': 'contact@ebanista.fr', 'comptabilite': 'comptabilite@ebanista.fr' };\nconst ORDER = ['v.caufriez', 'contact', 'comptabilite'];\n\nif (rows.length === 0) {\n  return [{ json: { text: \"📋 Digest quotidien EBANISTA\\n\\nAucun mail à traiter aujourd'hui.\", count: 0 } }];\n}\n\n// regroupement par boîte (les anciennes lignes sans boîte viennent de v.caufriez)\nconst groups = {};\nfor (const r of rows) {\n  const box = r.boite || 'v.caufriez';\n  (groups[box] = groups[box] || []).push(r);\n}\nconst boxes = [...ORDER.filter(b => groups[b]), ...Object.keys(groups).filter(b => !ORDER.includes(b))];\n\n// un bloc de texte par boîte, puis découpage en messages de taille raisonnable\nconst blocks = [];\nfor (const box of boxes) {\n  const list = groups[box];\n  blocks.push(`📥 ${LABELS[box] || box} (${list.length})`);\n  for (const r of list) {\n    blocks.push(`• [${r.categorie}] ${r.expediteur}\\n  ${r.resume}`);\n  }\n}\n\nconst header = `📋 Digest quotidien EBANISTA — ${rows.length} mail(s)`;\nconst chunks = [];\nlet current = header;\nfor (const b of blocks) {\n  const next = current + '\\n\\n' + b;\n  if (next.length > LIMIT && current !== header) {\n    chunks.push(current);\n    current = '(suite)\\n\\n' + b;\n  } else {\n    current = next;\n  }\n}\nchunks.push(current);\n\nreturn chunks.map(text => ({ json: { text, count: rows.length } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "d1a1b111-0000-4000-8000-000000000003",
      "name": "Build digest text"
    },
